{
  "name": "shape-shifting-vehicle-race-game",
  "private": true,
  "type": "module",
  "description": "Three.js presentation for the Shape Shifting: Vehicle Race engine (YouTube Playables target)",
  "scripts": {
    "build": "node build.mjs",
    "dev": "node build.mjs --serve",
    "test": "node --test test/track.test.mjs",
    "package": "node tools/package.mjs",
    "check:playables": "node tools/playables-check.mjs",
    "thumbnails": "node tools/thumbnails.mjs",
    "screenshots": "node build.mjs --preview && node tools/screenshots.mjs"
  },
  "dependencies": {
    "three": "0.186.1"
  },
  "devDependencies": {
    "esbuild": "0.28.2"
  }
}
